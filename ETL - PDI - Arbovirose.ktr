  <step>
    <name>Modified JavaScript value</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
// Converte o código de idade do SINAN (NU_IDADE_N) para idade inteira em anos
var codigo_idade = String(NU_IDADE_N);
var idade_anos = 0;

if (codigo_idade != null &amp;&amp; codigo_idade.length == 4) {
    var prefixo = codigo_idade.substring(0, 1);
    var valor = parseInt(codigo_idade.substring(1, 4), 10);
    
    if (prefixo == "4") {
        idade_anos = valor; // Maior de 1 ano
    } else {
        idade_anos = 0; // Menor de 1 ano (dias/meses/horas)
    }
} else {
    idade_anos = null;

}

</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
