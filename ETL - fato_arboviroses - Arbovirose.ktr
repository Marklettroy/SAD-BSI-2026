  <step>
    <name>Modified JavaScript value</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var idade_str = trim(NU_IDADE_N);
var idade_final = "Não Informado / Ignorado";

if (idade_str != null &amp;&amp; idade_str.length == 4) {
    var tipo = idade_str.substr(0, 1); // 1=Hora, 2=Dia, 3=Mês, 4=Ano
    var valor = parseInt(idade_str.substr(1, 3), 10);

    if (!isNaN(valor)) {
        if (tipo == "4" &amp;&amp; valor >= 1 &amp;&amp; valor &lt;= 120) {
            // Idade inteira completa em anos (1 a 120)
            idade_final = String(valor);
        } else if (tipo == "3" &amp;&amp; valor >= 1 &amp;&amp; valor &lt;= 11) {
            // Apenas meses válidos (1 a 11) -> 0.1 até 0.11
            idade_final = "0." + valor;
        } else if (tipo == "2" || tipo == "1") {
            // Dias ou horas (menos de 1 mês) -> 0
            idade_final = "0";
        }
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>idade_final</name>
        <rename>idade</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
